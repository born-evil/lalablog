---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

interface GalleryItem {
  slug: string;
  data: {
    type: "image" | "video";
    title: string;
    caption?: string;
    image?: any;
    thumbnail?: string;
    video?: string;
  };
}

interface Props {
  items: GalleryItem[];
  currentPage: number;
  totalPages: number;
}

const { items, currentPage, totalPages } = Astro.props;

const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
const pageHref = (page: number) => (page === 1 ? "/gallery/" : `/gallery/${page}/`);
---

<BaseLayout title="Gallery">
  <div class="gallery-grid">
    {
      items.map((item, index) => {
        const previousItem = items[(index - 1 + items.length) % items.length];
        const nextItem = items[(index + 1) % items.length];

        return (
          <>
            <article class="gallery-item">
              <a
                href={`#gallery-${item.slug}`}
                class={`gallery-thumb${item.data.type === "video" ? " is-video" : ""}`}
              >
                {
                  item.data.type === "video" ? (
                    item.data.thumbnail ? (
                      <img
                        src={item.data.thumbnail}
                        alt={item.data.caption ?? item.data.title}
                        loading="lazy"
                      />
                    ) : (
                      <video
                        class="gallery-thumb-video"
                        src={`${item.data.video}#t=0.001`}
                        muted
                        playsinline
                        preload="metadata"
                      />
                    )
                  ) : (
                    <Image
                      src={item.data.image}
                      alt={item.data.caption ?? item.data.title}
                      width={600}
                      height={600}
                      fit="cover"
                      quality={90}
                      loading="lazy"
                    />
                  )
                }
                {
                  item.data.type === "video" && (
                    <span class="gallery-video-badge" aria-hidden="true">▶</span>
                  )
                }
              </a>
            </article>

            <div
              id={`gallery-${item.slug}`}
              class="lightbox"
              aria-modal="true"
              data-gallery-lightbox
            >
              <a href="#page-top" class="lightbox-backdrop" aria-label="Close enlarged item"></a>
              <div class="lightbox-panel">
                <a href="#page-top" class="lightbox-close" aria-label="Close enlarged item">Close</a>
                {items.length > 1 && (
                  <>
                    <a
                      href={`#gallery-${previousItem.slug}`}
                      class="lightbox-arrow lightbox-arrow-left"
                      aria-label="Previous item"
                    >
                      ←
                    </a>
                    <a
                      href={`#gallery-${nextItem.slug}`}
                      class="lightbox-arrow lightbox-arrow-right"
                      aria-label="Next item"
                    >
                      →
                    </a>
                  </>
                )}
                {
                  item.data.type === "video" ? (
                    <video
                      class="lightbox-video"
                      src={item.data.video}
                      controls
                      playsinline
                      preload="metadata"
                    />
                  ) : (
                    <Image
                      src={item.data.image}
                      alt={item.data.caption ?? item.data.title}
                      width={1600}
                      fit="inside"
                      quality={95}
                    />
                  )
                }
                <div class="lightbox-copy">
                  <h2>{item.data.title}</h2>
                  {item.data.caption && <p>{item.data.caption}</p>}
                </div>
              </div>
            </div>
          </>
        );
      })
    }
  </div>

  {
    totalPages > 1 && (
      <nav class="gallery-pagination" aria-label="Gallery pages">
        {
          pageNumbers.map((pageNumber) =>
            pageNumber === currentPage ? (
              <span class="gallery-page-link is-current" aria-current="page">
                {pageNumber}
              </span>
            ) : (
              <a href={pageHref(pageNumber)} class="gallery-page-link">
                {pageNumber}
              </a>
            )
          )
        }
      </nav>
    )
  }
</BaseLayout>
